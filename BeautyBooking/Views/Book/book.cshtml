@using System.Globalization
@using BeautyBooking.Localization
@{
    Layout = null;
    var currentLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Func<string, string> T = key => SiteText.Get(key, currentLanguage);
}
<!doctype html>
<html class="no-js" lang="@currentLanguage">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@T("BookPageTitle") | Anova</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

    <link rel="stylesheet" href="/css/vendor.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>

<body class="contact-page">
    <header class="site-nav-wrap" style="padding: 20px 0;">
        <div class="container"
             style="display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center;">
            <a href="/home?culture=@currentLanguage&ui-culture=@currentLanguage"
               class="btn btn-bordered btn-dark">@T("NavHome")</a>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a href="/book?culture=da&ui-culture=da">DA</a>
                <a href="/book?culture=en&ui-culture=en">EN</a>
                <a href="/book?culture=fr&ui-culture=fr">FR</a>
                <a href="/book?culture=de&ui-culture=de">DE</a>
                <a href="/book?culture=zh&ui-culture=zh">中文</a>
            </div>
        </div>
    </header>

    <main class="space">
        <div class="container" style="margin-bottom: 20px;">
            <h1>@T("BookPageTitle")</h1>
            <p>@T("BookPageLead")</p>
            <a href="/book/elev?culture=@currentLanguage&ui-culture=@currentLanguage"
               class="btn btn-bordered btn-dark">@T("BookStudentOption")</a>
        </div>

        <iframe src="https://salonanova.setmore.com" width="100%" height="1100" frameborder="0"
                title="@T("BookPageTitle")"></iframe>
    </main>
</body>

</html>
